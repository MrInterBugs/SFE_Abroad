<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UK Student Loan Overseas Repayment Calculator <%= selectedYear %></title>
<meta name="description" content="Free <%= selectedYear %> calculator for UK graduates living abroad. Enter your salary in local currency to estimate monthly Student Loans Company repayments for Plan 1, 2, 4, 5, or Postgraduate Loans.">
<link rel="canonical" href="https://sfe.aedanl.com/">
<meta property="og:title" content="UK Student Loan Overseas Repayment Calculator <%= selectedYear %>">
<meta property="og:description" content="Living abroad? Estimate your monthly UK student loan repayment in seconds. Supports Plan 1, 2, 4, 5, and Postgraduate Loans.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://sfe.aedanl.com/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="UK Student Loan Overseas Repayment Calculator <%= selectedYear %>">
<meta name="twitter:description" content="Living abroad? Estimate your monthly UK student loan repayment in seconds.">
<% if (locals.allowMarketingScripts) { %>
<script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="e556bd88-52ac-451e-bb8c-7e9a69fa2193" data-blockingmode="auto" type="text/javascript"></script>
<% } %>
<script type="application/ld+json" nonce="<%= locals.cspNonce || '' %>">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Aedan L",
      "url": "https://sfe.aedanl.com/about"
    },
    {
      "@type": "WebApplication",
      "name": "UK Student Loan Overseas Repayment Calculator",
      "description": "Calculate your UK Student Finance monthly repayment obligation as a graduate living abroad.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "url": "https://sfe.aedanl.com/",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "GBP" },
      "featureList": [
        "Overseas student loan repayment estimates",
        "Plan 1, Plan 2, Plan 4, Plan 5, and Postgraduate Loan support",
        "Country-specific overseas earnings thresholds"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How is my UK student loan repayment calculated when living abroad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Student Loans Company converts your local salary to GBP using an indicative exchange rate, then applies the same repayment rate as in the UK — 9% of income above the overseas earnings threshold for Plans 1, 2, 4, and 5, or 6% above the threshold for Postgraduate Loans."
          }
        },
        {
          "@type": "Question",
          "name": "What is the overseas repayment threshold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each country has a specific GBP earnings threshold set by the Student Loans Company, broadly equivalent to the UK threshold adjusted for local cost of living. You only repay on income above that threshold."
          }
        },
        {
          "@type": "Question",
          "name": "Does my repayment plan affect overseas repayments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Plan 1 (pre-2012 England & Wales / all Northern Ireland), Plan 2 (2012–2023 England & Wales), Plan 4 (Scotland), and Plan 5 (2023-onwards England & Wales) all have different GBP thresholds per country, though the repayment rate is 9% for all undergraduate plans."
          }
        },
        {
          "@type": "Question",
          "name": "How often do overseas repayment thresholds change?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thresholds are reviewed annually by the Student Loans Company, usually updated for each new tax year (April). Exchange rates used in official notices may differ from live market rates."
          }
        }
      ]
    }
  ]
}
</script>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<% if (locals.allowMarketingScripts) { %>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4989908161831974" crossorigin="anonymous"></script>
<% } %>
</head>
<body>

<!-- Server data for autocomplete -->
<script type="application/json" id="app-data" nonce="<%= locals.cspNonce || '' %>"><%- JSON.stringify({ countries: countries, graduationDate: graduationDate, loanValueGbp: locals.loanValueGbp || null, loanValuePglGbp: locals.loanValuePglGbp || null }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %></script>

<div class="page">

  <!-- Header -->
  <header class="header">
    <div class="header-inner">
      <div class="header-crown">
        <svg class="crown-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="22" cy="22" r="12" fill="#e8f0fb" stroke="#1d70b8" stroke-width="1.5"/>
          <ellipse cx="22" cy="22" rx="5.5" ry="12" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <line x1="10" y1="22" x2="34" y2="22" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <rect x="4" y="11" width="18" height="3" rx="1.5" fill="#1d70b8"/>
          <polygon points="13,5 4,11 22,11" fill="#1d70b8"/>
          <line x1="22" y1="11" x2="22" y2="17" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="22" cy="18" r="1.5" fill="#1d70b8"/>
        </svg>
        <span class="header-title">Student Finance Overseas Repayment Calculator</span>
      </div>
      <nav class="header-nav">
        <% if (locals.userId) { %>
          <a href="/profile" class="header-nav-user">
            <span class="header-nav-avatar-sm"><%= (locals.userEmail || '?').charAt(0).toUpperCase() %></span>
            My profile
          </a>
        <% } else { %>
          <a href="/login" class="header-nav-link">Sign in</a>
          <a href="/register" class="header-nav-pill">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="main">
    <div class="container">

      <div class="page-heading">
        <h1>Estimate your overseas repayments</h1>
        <p>For UK graduates living abroad. Enter your salary in local currency to see your monthly obligation.</p>
      </div>

      <div class="calc-layout">
      <!-- Left: form -->
      <div class="calc-col-form">
      <div class="card" id="form-card">
        <form id="calc-form" action="/calculate" method="POST" novalidate>
          <input type="hidden" name="csrfToken" value="<%= locals.csrfToken || '' %>" id="csrf-input">

          <!-- Tax year -->
          <div class="form-group">
            <span class="field-label">Tax Year</span>
            <div class="seg-control" role="radiogroup" aria-label="Tax year">
              <% supportedYears.forEach(function(year) { %>
                <input type="radio" name="selectedYear" id="ty-<%= year.replace('-','') %>" value="<%= year %>" <%= year === selectedYear ? 'checked' : '' %>>
                <label for="ty-<%= year.replace('-','') %>"><%= year %></label>
              <% }); %>
            </div>
          </div>

          <hr class="form-divider">

          <!-- Repayment plan -->
          <div class="form-group">
            <span class="field-label">Repayment Plan</span>
            <div class="plan-grid" role="radiogroup" aria-label="Repayment plan">

              <div class="plan-card">
                <input type="radio" name="selectedPlan" id="plan1" value="plan1" <%= selectedPlan === 'plan1' ? 'checked' : '' %>>
                <label for="plan1">
                  <span class="plan-name">Plan 1</span>
                  <span class="plan-era">Pre-2012 England &amp; Wales, all NI</span>
                  <span class="plan-rate">9% above threshold</span>
                </label>
              </div>

              <div class="plan-card">
                <input type="radio" name="selectedPlan" id="plan2" value="plan2" <%= selectedPlan === 'plan2' ? 'checked' : '' %>>
                <label for="plan2">
                  <span class="plan-name">Plan 2</span>
                  <span class="plan-era">2012–2023 England &amp; Wales</span>
                  <span class="plan-rate">9% above threshold</span>
                </label>
              </div>

              <div class="plan-card">
                <input type="radio" name="selectedPlan" id="plan4" value="plan4" <%= selectedPlan === 'plan4' ? 'checked' : '' %>>
                <label for="plan4">
                  <span class="plan-name">Plan 4</span>
                  <span class="plan-era">Scotland (SAAS)</span>
                  <span class="plan-rate">9% above threshold</span>
                </label>
              </div>

              <div class="plan-card">
                <input type="radio" name="selectedPlan" id="plan5" value="plan5" <%= selectedPlan === 'plan5' ? 'checked' : '' %>>
                <label for="plan5">
                  <span class="plan-name">Plan 5</span>
                  <span class="plan-era">2023–present England &amp; Wales</span>
                  <span class="plan-rate">9% above threshold</span>
                </label>
              </div>

            </div>
          </div>

          <hr class="form-divider">

          <!-- PGL checkbox -->
          <div class="form-group">
            <label class="checkbox-row <%= includePg ? 'checked' : '' %>" id="pgl-row" for="pgl-check">
              <input type="checkbox" id="pgl-check" name="includePg" <%= includePg ? 'checked' : '' %>>
              <div>
                <div class="cb-text">I also have a Postgraduate Loan (PGL)</div>
                <div class="cb-sub">6% of income above the PGL threshold</div>
              </div>
            </label>
          </div>

          <hr class="form-divider">

          <!-- Country -->
          <div class="form-group">
            <label class="field-label" for="country-input">Country of Residence</label>
            <div class="autocomplete-wrap">
              <div class="input-wrap">
                <input type="text" id="country-input" name="targetCountry" placeholder="e.g. Germany, Australia, Canada…" autocomplete="off" value="<%= selectedCountry %>">
              </div>
              <div class="autocomplete-list" id="ac-list" role="listbox"></div>
            </div>
            <span class="field-error" id="country-error">Please select a country from the list</span>
          </div>

          <!-- Salary -->
          <div class="form-group">
            <label class="field-label" for="salary-input">Annual Salary</label>
            <span class="field-hint">Enter your gross salary in local currency, not GBP</span>
            <div class="input-wrap input-with-currency">
              <span class="currency-badge" id="currency-badge">—</span>
              <input type="number" id="salary-input" name="salaryLocalCurrency" placeholder="0" min="0" step="1000" value="<%= locals.defaultSalary || '' %>">
            </div>
            <span class="field-error" id="salary-error">Please enter your annual salary</span>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-calculate" id="calc-btn">
            Calculate monthly repayment
          </button>

        </form>
      </div>
      </div><!-- /calc-col-form -->

      <!-- Right: results -->
      <div class="calc-col-results">

      <!-- Empty state -->
      <div class="results-placeholder" id="results-placeholder">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true" style="margin-bottom:12px;opacity:0.35;">
          <rect x="4" y="4" width="28" height="28" rx="4" stroke="#1d70b8" stroke-width="2"/>
          <path d="M11 18h14M11 13h8M11 23h5" stroke="#1d70b8" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <p>Fill in the form and click <strong>Calculate</strong> to see your estimated monthly repayment here.</p>
      </div>

      <div class="results-card" id="results-card" aria-live="polite">
        <div class="results-header">
          <div>
            <div class="results-header-label">Monthly repayment</div>
            <div class="results-main-amount" id="res-monthly">£0</div>
            <div class="results-main-period" id="res-period">per month</div>
          </div>
          <div class="results-badge">
            <div class="results-badge-label">Annual</div>
            <div class="results-badge-val" id="res-annual">£0</div>
          </div>
        </div>

        <div class="results-body">

          <!-- Meta row -->
          <div class="results-meta">
            <div class="meta-item">
              <div class="meta-label">Earnings threshold</div>
              <div class="meta-value" id="res-threshold">—</div>
              <div class="meta-sub">per year (GBP)</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Exchange rate</div>
              <div class="meta-value" id="res-rate">—</div>
              <div class="meta-sub" id="res-rate-sub">per GBP</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">GBP equivalent</div>
              <div class="meta-value" id="res-gbp">—</div>
              <div class="meta-sub">gross annual salary</div>
            </div>
          </div>

          <!-- No repayment notice -->
          <div class="no-repayment" id="no-rep-notice">
            <span class="no-rep-icon">✓</span>
            <div class="no-rep-text">
              No repayment required
              <span id="no-rep-sub">Your salary is below the repayment threshold.</span>
            </div>
          </div>

          <!-- PGL breakdown -->
          <div class="breakdown-grid" id="breakdown-grid">
            <div class="breakdown-item">
              <div class="breakdown-item-label">Undergraduate</div>
              <div class="breakdown-item-amount" id="bd-ug">£—</div>
              <div class="breakdown-item-rate" id="bd-ug-rate">Plan — · 9%</div>
            </div>
            <div class="breakdown-item">
              <div class="breakdown-item-label">Postgraduate Loan</div>
              <div class="breakdown-item-amount" id="bd-pgl">£—</div>
              <div class="breakdown-item-rate">PGL · 6%</div>
            </div>
            <div class="breakdown-item combined">
              <div class="breakdown-item-label">Combined Total</div>
              <div class="breakdown-item-amount" id="bd-total">£—</div>
              <div class="breakdown-item-rate">per month</div>
            </div>
          </div>

          <!-- Write-off notice -->
          <div class="writeoff-notice" id="writeoff-notice" style="display:none;" aria-live="polite">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px;">
              <circle cx="7.5" cy="7.5" r="6.75" stroke="currentColor" stroke-width="1.3"/>
              <path d="M7.5 4.5v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="7.5" cy="10.5" r="0.7" fill="currentColor"/>
            </svg>
            <span id="writeoff-text"></span>
          </div>

          <!-- Repayment projection graph -->
          <div class="graph-panel" id="repayment-graph-panel" style="display:none;">
            <div class="graph-panel-header">
              <span class="graph-panel-title">Repayment projection</span>
            </div>
            <div class="graph-controls">
              <div class="graph-control-row">
                <label class="graph-label" for="loan-balance-input">UG loan balance</label>
                <div class="graph-balance-wrap">
                  <span class="graph-balance-prefix">£</span>
                  <input type="number" id="loan-balance-input" class="graph-balance-input" placeholder="e.g. 45000" min="0" step="100">
                </div>
              </div>
              <div class="graph-control-row" id="pgl-balance-row" style="display:none;">
                <label class="graph-label" for="pgl-balance-input">PGL balance</label>
                <div class="graph-balance-wrap">
                  <span class="graph-balance-prefix">£</span>
                  <input type="number" id="pgl-balance-input" class="graph-balance-input" placeholder="e.g. 12000" min="0" step="100">
                </div>
              </div>
              <div class="graph-control-row graph-control-row--slider">
                <label class="graph-label" for="rate-slider">Interest rate: <strong id="rate-display">6.5%</strong></label>
                <input type="range" id="rate-slider" class="graph-slider" min="0" max="15" step="0.1" value="6.5">
              </div>
            </div>
            <div class="graph-canvas-wrap">
              <canvas id="repayment-chart"></canvas>
            </div>
            <div class="graph-stats">
              <div class="graph-stat">
                <div class="graph-stat-label">Total interest from today</div>
                <div class="graph-stat-value" id="stat-interest">—</div>
              </div>
              <div class="graph-stat">
                <div class="graph-stat-label">Total paid from today</div>
                <div class="graph-stat-value" id="stat-paid">—</div>
              </div>
            </div>
            <p class="graph-disclaimer">Assumes constant salary and interest rate. Actual repayments will vary.</p>
          </div>

          <% if (locals.allowMarketingScripts) { %>
          <!-- Ad unit -->
          <div class="ad-unit">
            <ins class="adsbygoogle"
                style="display:block"
                data-ad-client="ca-pub-4989908161831974"
                data-ad-slot="8240706849"
                data-ad-format="auto"
                data-full-width-responsive="true"></ins>
          </div>
          <% } %>

        </div>
      </div><!-- /results-card -->

      </div><!-- /calc-col-results -->
      </div><!-- /calc-layout -->

      <!-- FAQ -->
      <section class="faq-section" aria-label="Frequently asked questions">
        <h2>How does overseas student loan repayment work?</h2>
        <dl class="faq-list">
          <div class="faq-item">
            <dt>How is my repayment calculated when living abroad?</dt>
            <dd>The Student Loans Company converts your local salary to GBP using an indicative exchange rate, then applies the same rate as in the UK — 9% of income above the overseas earnings threshold for Plans 1, 2, 4, and 5, or 6% for Postgraduate Loans.</dd>
          </div>
          <div class="faq-item">
            <dt>What is the overseas earnings threshold?</dt>
            <dd>Each country has a specific GBP threshold set by the SLC, broadly equivalent to the UK threshold adjusted for local cost of living. You only repay on income above that figure — if your salary converts below the threshold, nothing is owed.</dd>
          </div>
          <div class="faq-item">
            <dt>Does my plan type affect overseas repayments?</dt>
            <dd>Yes. Plan 1 (pre-2012 England & Wales / all Northern Ireland), Plan 2 (2012–2023 England & Wales), Plan 4 (Scotland), and Plan 5 (2023-onwards England & Wales) each have different country thresholds, though the repayment rate is 9% for all undergraduate plans.</dd>
          </div>
          <div class="faq-item">
            <dt>How often do overseas thresholds change?</dt>
            <dd>Thresholds are reviewed annually by the SLC and updated each tax year (April). Exchange rates used in official repayment notices may differ from live market rates — this calculator uses indicative figures.</dd>
          </div>
        </dl>
      </section>

      <br>
      
      <!-- Footer note -->
      <p style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:8px;">
        Thresholds and rates sourced from
        <a href="https://www.gov.uk/repaying-your-student-loan" target="_blank" rel="noopener"
           style="color:var(--blue);text-decoration:none;">GOV.UK</a>.
        Exchange rates are indicative — SLC may use different rates for official notices.
      </p>

    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-note">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="#8a9198"/>
          <path d="M7 6v4M7 4.5v.5" stroke="#8a9198" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        This is an estimate only. Your actual repayments may differ — verify with the
        <a href="https://www.gov.uk/government/organisations/student-loans-company" target="_blank" rel="noopener">Student Loans Company</a>.
      </div>
      <div class="footer-links">
        <a href="https://www.gov.uk/repaying-your-student-loan" target="_blank" rel="noopener">GOV.UK guidance</a>
        <a href="https://www.gov.uk/contact-student-loans-company" target="_blank" rel="noopener">SLC contact</a>
        <a href="/methodology">Methodology</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </footer>

</div>

<script src="/main.js"></script>
</body>
</html>
