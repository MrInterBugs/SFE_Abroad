<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register — Student Finance Overseas Calculator</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<script nonce="<%= locals.cspNonce || '' %>">document.documentElement.dataset.theme=localStorage.getItem('sfeDarkTheme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');</script>
</head>
<body>
<div class="page">

  <%- include('partials/header', {
    headerNavItems: [
      { href: '/login', label: 'Sign in', className: 'header-nav-link' }
    ]
  }) %>

  <main class="main">
    <div class="container" style="max-width:480px;">
      <div class="page-heading">
        <h1>Create an account</h1>
        <p>Save your loan details to speed up future calculations.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>

      <div class="card" style="padding:28px;">
        <form method="POST" action="/register" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="field-label" for="email">Email address</label>
            <div class="input-wrap">
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="password">Password</label>
            <span class="field-hint">Minimum 10 characters</span>
            <div class="input-wrap">
              <input type="password" id="password" name="password" autocomplete="new-password" required minlength="10">
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="confirmPassword">Confirm password</label>
            <div class="input-wrap">
              <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required>
            </div>
          </div>

          <button type="submit" class="btn-calculate" style="margin-top:8px;">Create account</button>
        </form>

        <p style="margin-top:20px;font-size:13px;color:var(--text-secondary);text-align:center;">
          Already have an account? <a href="/login" style="color:var(--blue);">Sign in</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

</div>
<script src="/theme.js" defer></script>
</body>
</html>
