<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile — Student Finance Overseas</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

  <header class="header">
    <div class="header-inner">
      <div class="header-crown">
        <svg class="crown-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="22" cy="22" r="12" fill="#e8f0fb" stroke="#1d70b8" stroke-width="1.5"/>
          <ellipse cx="22" cy="22" rx="5.5" ry="12" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <line x1="10" y1="22" x2="34" y2="22" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <rect x="4" y="11" width="18" height="3" rx="1.5" fill="#1d70b8"/>
          <polygon points="13,5 4,11 22,11" fill="#1d70b8"/>
          <line x1="22" y1="11" x2="22" y2="17" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="22" cy="18" r="1.5" fill="#1d70b8"/>
        </svg>
        <a href="/" style="text-decoration:none;color:inherit;"><span class="header-title">Student Finance Overseas Repayment Calculator</span></a>
      </div>
      <nav class="header-nav">
        <span class="header-nav-email"><%= user.email %></span>
        <form method="POST" action="/logout" style="margin:0;">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <button type="submit" class="header-nav-link">Sign out</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="main">
    <div class="container" style="max-width:520px;">

      <!-- User hero -->
      <div class="profile-hero">
        <div class="profile-avatar"><%= user.email.charAt(0).toUpperCase() %></div>
        <div class="profile-hero-info">
          <div class="profile-hero-email"><%= user.email %></div>
          <div class="profile-hero-since">Member since <%= new Date(user.created_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) %></div>
        </div>
        <a href="/" class="profile-hero-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Calculator
        </a>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert-success" role="alert">Profile saved.</div>
      <% } %>

      <!-- Loan details card -->
      <div class="card" style="padding:28px;margin-bottom:12px;">
        <div class="profile-section-label">Loan details</div>

        <form method="POST" action="/profile" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="profile-field-label" for="graduationDate">Graduation date</label>
            <span class="profile-field-hint">Month and year you completed your course — format: YYYY-MM</span>
            <div class="input-wrap">
              <input type="month" id="graduationDate" name="graduationDate"
                placeholder="YYYY-MM"
                value="<%= profile.graduation_date || '' %>">
            </div>
          </div>

          <hr class="form-divider">

          <div class="form-group">
            <label class="profile-field-label" for="loanValueGbp">Undergraduate loan balance</label>
            <span class="profile-field-hint">Outstanding balance as reported by the Student Loans Company</span>
            <div class="input-wrap input-with-currency">
              <span class="currency-badge">£</span>
              <input type="number" id="loanValueGbp" name="loanValueGbp" min="0" step="100" placeholder="0"
                value="<%= profile.loan_value_gbp != null ? profile.loan_value_gbp : '' %>">
            </div>
          </div>

          <hr class="form-divider">

          <div class="form-group" style="margin-bottom:0;">
            <label class="profile-field-label" for="loanValuePglGbp">Postgraduate loan balance</label>
            <span class="profile-field-hint">Leave blank if you don't have a Postgraduate Loan</span>
            <div class="input-wrap input-with-currency">
              <span class="currency-badge">£</span>
              <input type="number" id="loanValuePglGbp" name="loanValuePglGbp" min="0" step="100" placeholder="0"
                value="<%= profile.loan_value_pgl_gbp != null ? profile.loan_value_pgl_gbp : '' %>">
            </div>
          </div>

          <hr class="form-divider">

          <div class="profile-section-label" style="margin-top:0;">Calculator defaults</div>

          <div class="form-group">
            <label class="profile-field-label" for="defaultCountry">Default country</label>
            <span class="profile-field-hint">Pre-selects your country of residence on the calculator</span>
            <div class="select-wrap">
              <select id="defaultCountry" name="defaultCountry">
                <option value="">— None —</option>
                <% countries.forEach(function(c) { %>
                  <option value="<%= c %>" <%= profile.default_country === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="profile-field-label" for="defaultSalary">Default annual salary</label>
            <span class="profile-field-hint">In your local currency — pre-fills the salary field on the calculator</span>
            <div class="input-wrap">
              <input type="number" id="defaultSalary" name="defaultSalary" min="0" step="1000" placeholder="0"
                value="<%= profile.default_salary != null ? profile.default_salary : '' %>">
            </div>
          </div>

          <div class="form-group">
            <span class="profile-field-label">Default repayment plan</span>
            <div class="plan-grid">
              <% const planMeta = { plan1: { name: 'Plan 1', era: 'Pre-2012 England & Wales, all NI' }, plan2: { name: 'Plan 2', era: '2012–2023 England & Wales' }, plan4: { name: 'Plan 4', era: 'Scotland (SAAS)' }, plan5: { name: 'Plan 5', era: '2023–present England & Wales' } }; %>
              <% ugPlans.forEach(function(p) { %>
                <div class="plan-card">
                  <input type="radio" name="defaultPlan" id="dp-<%= p %>" value="<%= p %>" <%= (profile.default_plan || 'plan1') === p ? 'checked' : '' %>>
                  <label for="dp-<%= p %>">
                    <span class="plan-name"><%= planMeta[p].name %></span>
                    <span class="plan-era"><%= planMeta[p].era %></span>
                  </label>
                </div>
              <% }); %>
            </div>
          </div>

          <div class="form-group" style="margin-bottom:0;">
            <label class="checkbox-row <%= profile.include_pg ? 'checked' : '' %>" id="profile-pgl-row" for="includePg">
              <input type="checkbox" id="includePg" name="includePg" <%= profile.include_pg ? 'checked' : '' %>>
              <div>
                <div class="cb-text">Include Postgraduate Loan by default</div>
                <div class="cb-sub">Pre-checks the PGL option on the calculator</div>
              </div>
            </label>
          </div>

          <button type="submit" class="btn-calculate" style="margin-top:24px;">Save profile</button>
        </form>

        <% if (profile.updated_at) { %>
          <p class="profile-updated">Last updated <%= new Date(profile.updated_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <% } %>
      </div>

      <!-- Danger zone card -->
      <div class="danger-card">
        <div class="danger-card-title">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 1.5L12.5 11.5H1.5L7 1.5Z" stroke="#b91c1c" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M7 5.5V8.5" stroke="#b91c1c" stroke-width="1.4" stroke-linecap="round"/>
            <circle cx="7" cy="10.2" r="0.65" fill="#b91c1c"/>
          </svg>
          Danger zone
        </div>
        <p class="danger-card-body">Permanently deletes your account and all saved data. This cannot be undone.</p>
        <form method="POST" action="/profile/delete">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <button type="submit" class="btn-delete"
            onclick="return confirm('Are you sure? This will permanently delete your account and all saved data.')">
            Delete my account
          </button>
        </form>
      </div>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-note">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="#8a9198"/>
          <path d="M7 6v4M7 4.5v.5" stroke="#8a9198" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        Your data is stored privately and not shared with any third party.
      </div>
      <div class="footer-links">
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </footer>

</div>
<script nonce="<%= locals.cspNonce || '' %>">
  const pglCheck = document.getElementById('includePg');
  const pglRow = document.getElementById('profile-pgl-row');
  if (pglCheck) pglCheck.addEventListener('change', () => pglRow.classList.toggle('checked', pglCheck.checked));
</script>
</body>
</html>
