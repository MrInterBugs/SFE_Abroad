<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset password — Student Finance Overseas Calculator</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<script nonce="<%= locals.cspNonce || '' %>">document.documentElement.dataset.theme=localStorage.getItem('sfeDarkTheme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');</script>
</head>
<body>
<div class="page">

  <header class="header">
    <div class="header-inner">
      <div class="header-crown">
        <a href="/" style="text-decoration:none;color:inherit;"><span class="header-title">Student Finance Overseas Repayment Calculator</span></a>
      </div>
      <nav class="header-nav">
        <a href="/login" class="header-nav-link">Sign in</a>
      </nav>
    </div>
  </header>

  <main class="main">
    <div class="container" style="max-width:480px;">
      <div class="page-heading">
        <h1>Reset password</h1>
        <p>Enter your email address and we will send a reset link.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="alert-success" role="status"><%= message %></div>
      <% } %>

      <div class="card" style="padding:28px;">
        <form method="POST" action="/forgot-password" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="field-label" for="email">Email address</label>
            <div class="input-wrap">
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>

          <button type="submit" class="btn-calculate" style="margin-top:8px;">Send reset link</button>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

</div>
<script src="/theme.js" defer></script>
</body>
</html>
