<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Student Finance Overseas</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

  <header class="header">
    <div class="header-inner">
      <div class="header-crown">
        <svg class="crown-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="22" cy="22" r="12" fill="#e8f0fb" stroke="#1d70b8" stroke-width="1.5"/>
          <ellipse cx="22" cy="22" rx="5.5" ry="12" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <line x1="10" y1="22" x2="34" y2="22" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
          <rect x="4" y="11" width="18" height="3" rx="1.5" fill="#1d70b8"/>
          <polygon points="13,5 4,11 22,11" fill="#1d70b8"/>
          <line x1="22" y1="11" x2="22" y2="17" stroke="#1d70b8" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="22" cy="18" r="1.5" fill="#1d70b8"/>
        </svg>
        <a href="/" style="text-decoration:none;color:inherit;"><span class="header-title">Student Finance Overseas Repayment Calculator</span></a>
      </div>
      <nav class="header-nav">
        <button data-href="/register" class="header-nav-pill">Register</button>
      </nav>
    </div>
  </header>

  <main class="main">
    <div class="container" style="max-width:480px;">
      <div class="page-heading">
        <h1>Sign in</h1>
        <p>Access your saved loan profile.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (locals.unconfirmedEmailError) { %>
        <div class="alert-error" role="alert">
          Please confirm your email address before signing in.
          <a href="/check-email" style="color:inherit;font-weight:600;">Resend confirmation email.</a>
        </div>
      <% } %>
      <% if (message) { %>
        <div class="alert-success" role="status"><%= message %></div>
      <% } %>

      <div class="card" style="padding:28px;">
        <form method="POST" action="/login" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="field-label" for="email">Email address</label>
            <div class="input-wrap">
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="password">Password</label>
            <div class="input-wrap">
              <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
          </div>

          <button type="submit" class="btn-calculate" style="margin-top:8px;">Sign in</button>
        </form>

        <p style="margin-top:20px;font-size:13px;color:var(--text-secondary);text-align:center;">
          <a href="/forgot-password" style="color:var(--blue);">Forgot password?</a>
        </p>
        <p style="margin-top:10px;font-size:13px;color:var(--text-secondary);text-align:center;">
          No account yet? <a href="/register" style="color:var(--blue);">Create one</a>
        </p>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-note">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="#8a9198"/>
          <path d="M7 6v4M7 4.5v.5" stroke="#8a9198" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        This is an estimate only. Verify with the <a href="https://www.gov.uk/government/organisations/student-loans-company" target="_blank" rel="noopener">Student Loans Company</a>.
      </div>
      <div class="footer-links">
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </footer>

</div>
<script src="/nav.js"></script>
</body>
</html>
