<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Student Finance Overseas Calculator</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<%- include('partials/theme-boot') %>
</head>
<body>
<div class="page">

  <%- include('partials/header', {
    headerNavItems: [
      { href: '/register', label: 'Register', className: 'header-nav-pill' }
    ]
  }) %>

  <main class="main">
    <div class="container auth-container">
      <div class="page-heading">
        <h1>Sign in</h1>
        <p>Access your saved loan profile.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (locals.unconfirmedEmailError) { %>
        <div class="alert-error" role="alert">
          Please confirm your email address before signing in.
          <a href="/check-email" class="auth-inline-link-muted">Resend confirmation email.</a>
        </div>
      <% } %>
      <% if (message) { %>
        <div class="alert-success" role="status"><%= message %></div>
      <% } %>

      <div class="card">
        <form method="POST" action="/login" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="field-label" for="email">Email address</label>
            <div class="input-wrap">
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="password">Password</label>
            <div class="input-wrap">
              <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
          </div>

          <button type="submit" class="btn-calculate btn-form-submit">Sign in</button>
        </form>

        <p class="auth-card-link">
          <a href="/forgot-password">Forgot password?</a>
        </p>
        <p class="auth-card-copy">
          No account yet? <a href="/register" class="auth-inline-link">Create one</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

</div>
<script src="/theme.js" defer></script>
</body>
</html>
