<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Student Finance Overseas Calculator</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<script nonce="<%= locals.cspNonce || '' %>">document.documentElement.dataset.theme=localStorage.getItem('sfeDarkTheme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');</script>
</head>
<body>
<div class="page">

  <%- include('partials/header', {
    headerNavItems: [
      { href: '/register', label: 'Register', className: 'header-nav-pill' }
    ]
  }) %>

  <main class="main">
    <div class="container" style="max-width:480px;">
      <div class="page-heading">
        <h1>Sign in</h1>
        <p>Access your saved loan profile.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (locals.unconfirmedEmailError) { %>
        <div class="alert-error" role="alert">
          Please confirm your email address before signing in.
          <a href="/check-email" style="color:inherit;font-weight:600;">Resend confirmation email.</a>
        </div>
      <% } %>
      <% if (message) { %>
        <div class="alert-success" role="status"><%= message %></div>
      <% } %>

      <div class="card" style="padding:28px;">
        <form method="POST" action="/login" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="form-group">
            <label class="field-label" for="email">Email address</label>
            <div class="input-wrap">
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>

          <div class="form-group">
            <label class="field-label" for="password">Password</label>
            <div class="input-wrap">
              <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
          </div>

          <button type="submit" class="btn-calculate" style="margin-top:8px;">Sign in</button>
        </form>

        <p style="margin-top:20px;font-size:13px;color:var(--text-secondary);text-align:center;">
          <a href="/forgot-password" style="color:var(--blue);">Forgot password?</a>
        </p>
        <p style="margin-top:10px;font-size:13px;color:var(--text-secondary);text-align:center;">
          No account yet? <a href="/register" style="color:var(--blue);">Create one</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

</div>
<script src="/theme.js" defer></script>
</body>
</html>
