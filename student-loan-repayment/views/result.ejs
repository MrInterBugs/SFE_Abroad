<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  const planLabel = locals.selectedPlan === 'plan1' ? 'Plan 1'
    : locals.selectedPlan === 'plan2' ? 'Plan 2'
    : locals.selectedPlan === 'plan4' ? 'Plan 4'
    : locals.selectedPlan === 'plan5' ? 'Plan 5'
    : 'Result';
  const pageTitle = locals.targetCountry && locals.selectedPlan
    ? `${planLabel} · ${locals.targetCountry} — UK Student Loan Repayment`
    : 'Calculation Result — UK Student Loan Overseas Repayment';
%>
<title><%= pageTitle %></title>
<script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="e556bd88-52ac-451e-bb8c-7e9a69fa2193" data-blockingmode="auto" type="text/javascript"></script>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" data-cookieconsent="ignore"></script>
</head>
<body>
<div class="page">

  <!-- Header -->
  <header class="header">
    <div class="header-inner">
      <div class="header-crown">
        <svg class="crown-icon" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 2L4 10V26H28V10L16 2Z" fill="#1d70b8" opacity="0.15"/>
          <path d="M16 4L6 11V24H26V11L16 4Z" stroke="#1d70b8" stroke-width="1.5" fill="none"/>
          <circle cx="16" cy="8" r="2" fill="#1d70b8"/>
          <circle cx="7" cy="13" r="2" fill="#1d70b8"/>
          <circle cx="25" cy="13" r="2" fill="#1d70b8"/>
          <path d="M6 24H26" stroke="#1d70b8" stroke-width="2"/>
        </svg>
        <span class="header-title">Student Finance</span>
      </div>
      <div class="header-divider"></div>
      <span class="header-sub">Overseas Repayment Calculator</span>
    </div>
  </header>

  <main class="main">
    <div class="container">

      <div class="page-heading">
        <h1>Calculation Result</h1>
      </div>

      <% if (error) { %>
        <div class="card">
          <p style="color:#d4351c;font-weight:500;"><%= error %></p>
        </div>
      <% } %>

      <% if (locals.monthlyRepayment !== undefined) { %>
        <%
          const planLabel = selectedPlan === 'plan1' ? 'Plan 1'
            : selectedPlan === 'plan2' ? 'Plan 2'
            : selectedPlan === 'plan4' ? 'Plan 4'
            : 'Plan 5';
          const hasPgl = locals.pglMonthlyRepayment !== null && locals.pglMonthlyRepayment !== undefined;
          const totalMonthly = hasPgl
            ? (parseFloat(monthlyRepayment) + parseFloat(pglMonthlyRepayment)).toFixed(2)
            : monthlyRepayment;
        %>

        <!-- Results card -->
        <div class="results-card visible animate-in">
          <div class="results-header">
            <div>
              <div class="results-header-label">Monthly repayment</div>
              <div class="results-main-amount">£<%= totalMonthly %></div>
              <div class="results-main-period">per month</div>
            </div>
            <div class="results-badge">
              <div class="results-badge-label">Annual</div>
              <div class="results-badge-val">£<%= (parseFloat(totalMonthly) * 12).toFixed(0) %>/yr</div>
            </div>
          </div>

          <div class="results-body">
            <div class="results-meta">
              <div class="meta-item">
                <div class="meta-label">Earnings threshold</div>
                <div class="meta-value">£<%= thresholdGbp %></div>
                <div class="meta-sub">per year (GBP)</div>
              </div>
              <div class="meta-item">
                <div class="meta-label">Exchange rate</div>
                <div class="meta-value"><%= exchangeRate %></div>
                <div class="meta-sub">GBP per local unit</div>
              </div>
              <div class="meta-item">
                <div class="meta-label">GBP equivalent</div>
                <div class="meta-value">£<%= Math.round(parseFloat(salaryLocalCurrency) * parseFloat(exchangeRate)).toLocaleString() %></div>
                <div class="meta-sub">gross annual salary</div>
              </div>
            </div>

            <% if (parseFloat(monthlyRepayment) === 0 && (!hasPgl || parseFloat(pglMonthlyRepayment) === 0)) { %>
              <div class="no-repayment show">
                <span class="no-rep-icon">✓</span>
                <div class="no-rep-text">
                  No repayment required
                  <span>Your salary is below the <%= planLabel %> repayment threshold (£<%= thresholdGbp %>).</span>
                </div>
              </div>
            <% } %>

            <% if (hasPgl) { %>
              <div class="breakdown-grid show">
                <div class="breakdown-item">
                  <div class="breakdown-item-label">Undergraduate</div>
                  <div class="breakdown-item-amount">£<%= monthlyRepayment %></div>
                  <div class="breakdown-item-rate"><%= planLabel %> · 9%</div>
                </div>
                <div class="breakdown-item">
                  <div class="breakdown-item-label">Postgraduate Loan</div>
                  <div class="breakdown-item-amount">£<%= pglMonthlyRepayment %></div>
                  <div class="breakdown-item-rate">PGL · 6%</div>
                </div>
                <div class="breakdown-item combined">
                  <div class="breakdown-item-label">Combined Total</div>
                  <div class="breakdown-item-amount">£<%= totalMonthly %></div>
                  <div class="breakdown-item-rate">per month</div>
                </div>
              </div>
            <% } %>

            <% if (hasPgl && pglMonthlyRepayment !== null && parseFloat(pglMonthlyRepayment) === 0) { %>
              <p style="font-size:13px;color:var(--text-secondary);margin-top:12px;">
                Your salary is below the Postgraduate Loan repayment threshold (£<%= pglThresholdGbp %>). No PGL repayment due.
              </p>
            <% } %>
          </div>
        </div>

        <div class="card" style="margin-top:0;">
          <p style="font-size:13px;color:var(--text-secondary);margin-bottom:8px;">
            <strong>Plan:</strong> <%= planLabel %> &nbsp;·&nbsp;
            <strong>Tax year:</strong> <%= selectedYear %> &nbsp;·&nbsp;
            <strong>Country:</strong> <%= targetCountry %><br>
            <strong>Salary:</strong> <%= salaryCurrencySymbol %><%= salaryLocalCurrency %>
          </p>
        </div>

        <!-- Repayment projection graph -->
        <div class="graph-panel">
          <div class="graph-panel-header">
            <span class="graph-panel-title">Repayment projection</span>
          </div>
          <div class="graph-controls">
            <div class="graph-control-row">
              <label class="graph-label" for="loan-balance-input"><%= planLabel %> loan balance</label>
              <div class="graph-balance-wrap">
                <span class="graph-balance-prefix">£</span>
                <input type="number" id="loan-balance-input" class="graph-balance-input"
                  placeholder="e.g. 45000" min="0" step="100"
                  value="<%= locals.loanValueGbp ? locals.loanValueGbp : '' %>">
              </div>
            </div>
            <% if (hasPgl) { %>
            <div class="graph-control-row" id="pgl-balance-row">
              <label class="graph-label" for="pgl-balance-input">PGL balance</label>
              <div class="graph-balance-wrap">
                <span class="graph-balance-prefix">£</span>
                <input type="number" id="pgl-balance-input" class="graph-balance-input"
                  placeholder="e.g. 12000" min="0" step="100"
                  value="<%= locals.loanValuePglGbp ? locals.loanValuePglGbp : '' %>">
              </div>
            </div>
            <% } %>
            <div class="graph-control-row graph-control-row--slider">
              <label class="graph-label" for="rate-slider">Interest rate: <strong id="rate-display">6.5%</strong></label>
              <input type="range" id="rate-slider" class="graph-slider" min="0" max="15" step="0.1" value="6.5">
            </div>
          </div>
          <div class="graph-canvas-wrap">
            <canvas id="repayment-chart"></canvas>
          </div>
          <div class="graph-stats">
            <div class="graph-stat">
              <div class="graph-stat-label">Total interest from today</div>
              <div class="graph-stat-value" id="stat-interest">—</div>
            </div>
            <div class="graph-stat">
              <div class="graph-stat-label">Total paid from today</div>
              <div class="graph-stat-value" id="stat-paid">—</div>
            </div>
          </div>
          <p class="graph-disclaimer">Assumes constant salary and interest rate. Actual repayments will vary.</p>
        </div>
      <% } %>

      <a href="/" class="btn-calculate" style="display:block;text-align:center;text-decoration:none;margin-top:8px;">← Back to calculator</a>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-note">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="#8a9198"/>
          <path d="M7 6v4M7 4.5v.5" stroke="#8a9198" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        This is an estimate only — verify with the
        <a href="https://www.gov.uk/repaying-your-student-loan/living-or-working-overseas" target="_blank" rel="noopener">Student Loans Company</a>.
      </div>
    </div>
  </footer>

</div>

<% if (locals.monthlyRepayment !== undefined) { %>
<script>
(function () {
  const WRITE_OFF_YEARS = { plan1: 25, plan2: 30, plan4: 30, plan5: 40 };
  const GRADUATION_DATE = <%- JSON.stringify(locals.graduationDate || null) %>;
  const SELECTED_PLAN = <%- JSON.stringify(locals.selectedPlan) %>;
  const UG_MONTHLY = parseFloat(<%- JSON.stringify(locals.monthlyRepayment) %>);
  const PGL_MONTHLY = <%- JSON.stringify(locals.pglMonthlyRepayment || null) %> !== null
    ? parseFloat(<%- JSON.stringify(locals.pglMonthlyRepayment || '0') %>) : null;

  function calcWriteOffYear(graduationDate, plan) {
    const years = WRITE_OFF_YEARS[plan];
    if (!years || !graduationDate) return null;
    const [gradYear, gradMonth] = graduationDate.split('-').map(Number);
    const firstRepayYear = gradMonth <= 3 ? gradYear : gradYear + 1;
    return firstRepayYear + years;
  }

  function buildBalanceOverTime(startBalance, monthlyPayment, annualRatePct, maxYears) {
    const monthlyRate = annualRatePct / 100 / 12;
    let balance = startBalance;
    const data = [parseFloat(startBalance.toFixed(2))];
    let totalPaid = 0;
    let paidOff = false;
    let payoffYear = null;
    for (let yr = 1; yr <= maxYears; yr++) {
      if (!paidOff) {
        for (let m = 0; m < 12; m++) {
          const interest = balance * monthlyRate;
          const newBalance = Math.max(0, balance + interest - monthlyPayment);
          totalPaid += balance + interest - newBalance;
          balance = newBalance;
          if (balance === 0 && !paidOff) { paidOff = true; payoffYear = yr; }
        }
        balance = parseFloat(balance.toFixed(2));
      }
      data.push(paidOff ? 0 : balance);
    }
    const finalBalance = paidOff ? 0 : balance;
    const totalInterest = Math.max(0, totalPaid + finalBalance - startBalance);
    return { data, totalPaid: Math.round(totalPaid), totalInterest: Math.round(totalInterest), paidOff, payoffYear };
  }

  let chartInstance = null;

  function renderChart() {
    const balanceInput = document.getElementById('loan-balance-input');
    const pglBalanceInput = document.getElementById('pgl-balance-input');
    const rateSlider = document.getElementById('rate-slider');

    const ugBalance = parseFloat(balanceInput && balanceInput.value) || 0;
    const pglBalance = pglBalanceInput ? (parseFloat(pglBalanceInput.value) || 0) : 0;
    const interestRate = parseFloat(rateSlider && rateSlider.value) || 6.5;

    if (ugBalance <= 0) return;

    const currentYear = new Date().getFullYear();
    const writeOffCalYear = calcWriteOffYear(GRADUATION_DATE, SELECTED_PLAN)
      || (currentYear + (WRITE_OFF_YEARS[SELECTED_PLAN] || 30));
    const maxYears = Math.max(1, writeOffCalYear - currentYear);

    const ugResult = buildBalanceOverTime(ugBalance, UG_MONTHLY, interestRate, maxYears);
    let pglResult = null;
    if (PGL_MONTHLY !== null && pglBalance > 0) {
      pglResult = buildBalanceOverTime(pglBalance, PGL_MONTHLY, interestRate, maxYears);
    }

    const ugPaidOff = ugResult.paidOff && ugResult.payoffYear !== null;
    const pglPaidOff = !pglResult || (pglResult.paidOff && pglResult.payoffYear !== null);
    let displayYears = maxYears;
    if (ugPaidOff && pglPaidOff) {
      displayYears = Math.max(ugResult.payoffYear, pglResult ? pglResult.payoffYear : 0);
    }
    const labels = Array.from({ length: displayYears + 1 }, (_, i) => String(currentYear + i));

    let combinedPaid = ugResult.totalPaid;
    let combinedInterest = ugResult.totalInterest;

    const datasets = [{
      label: '<%- planLabel %> Loan',
      data: ugResult.data.slice(0, displayYears + 1),
      borderColor: '#1d70b8',
      backgroundColor: 'rgba(29,112,184,0.07)',
      fill: true, tension: 0.2, pointRadius: 0, borderWidth: 2,
    }];

    if (pglResult) {
      combinedPaid += pglResult.totalPaid;
      combinedInterest += pglResult.totalInterest;
      datasets.push({
        label: 'Postgraduate Loan',
        data: pglResult.data.slice(0, displayYears + 1),
        borderColor: '#00703c',
        backgroundColor: 'rgba(0,112,60,0.05)',
        fill: true, tension: 0.2, pointRadius: 0, borderWidth: 2, spanGaps: false,
      });
    }

    const fmtStat = v => '£' + v.toLocaleString('en-GB');
    const elInterest = document.getElementById('stat-interest');
    const elPaid = document.getElementById('stat-paid');
    if (elInterest) elInterest.textContent = fmtStat(combinedInterest);
    if (elPaid) elPaid.textContent = fmtStat(combinedPaid);

    const writeOffLinePlugin = {
      id: 'writeOffLine',
      afterDraw(chart) {
        const wLabel = String(writeOffCalYear);
        const wIdx = labels.indexOf(wLabel);
        if (wIdx < 0) return;
        const xScale = chart.scales.x;
        const yScale = chart.scales.y;
        const x = xScale.getPixelForValue(wLabel);
        const c = chart.ctx;
        c.save();
        c.beginPath();
        c.setLineDash([5, 4]);
        c.strokeStyle = 'rgba(212,53,28,0.55)';
        c.lineWidth = 1.5;
        c.moveTo(x, yScale.top);
        c.lineTo(x, yScale.bottom);
        c.stroke();
        c.font = '10px DM Sans, sans-serif';
        c.fillStyle = '#d4351c';
        c.textAlign = x > chart.width / 2 ? 'right' : 'left';
        c.fillText('Written off', x > chart.width / 2 ? x - 4 : x + 4, yScale.top - 6);
        c.restore();
      }
    };

    const ctx = document.getElementById('repayment-chart').getContext('2d');
    if (chartInstance) chartInstance.destroy();
    chartInstance = new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      plugins: [writeOffLinePlugin],
      options: {
        responsive: true,
        maintainAspectRatio: true,
        layout: { padding: { top: 18 } },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: datasets.length > 1, position: 'top', labels: { font: { family: 'DM Sans', size: 12 }, boxWidth: 12, padding: 16 } },
          tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: £${Math.round(ctx.raw ?? 0).toLocaleString('en-GB')}` } },
        },
        scales: {
          x: { ticks: { font: { family: 'DM Sans', size: 11 }, maxTicksLimit: 8, maxRotation: 0 }, grid: { color: 'rgba(0,0,0,0.04)' } },
          y: { min: 0, ticks: { font: { family: 'DM Sans', size: 11 }, callback: v => '£' + (v >= 1000 ? (v / 1000).toFixed(0) + 'k' : v), maxTicksLimit: 6 }, grid: { color: 'rgba(0,0,0,0.04)' } },
        },
      },
    });
  }

  const rateSlider = document.getElementById('rate-slider');
  const rateDisplay = document.getElementById('rate-display');
  if (rateSlider) {
    rateSlider.addEventListener('input', () => {
      rateDisplay.textContent = parseFloat(rateSlider.value).toFixed(1) + '%';
      renderChart();
    });
  }
  ['loan-balance-input', 'pgl-balance-input'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', renderChart);
  });

  renderChart();
})();
</script>
<% } %>
</body>
</html>
