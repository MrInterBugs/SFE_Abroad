<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page.metaTitle %></title>
<meta name="description" content="<%= page.description %>">
<link rel="canonical" href="<%= siteUrl %>/<%= page.slug %>">
<meta property="og:title" content="<%= page.metaTitle %>">
<meta property="og:description" content="<%= page.description %>">
<meta property="og:type" content="article">
<meta property="og:url" content="<%= siteUrl %>/<%= page.slug %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= page.metaTitle %>">
<meta name="twitter:description" content="<%= page.description %>">
<%- include('partials/cookiebot') %>
<script type="application/ld+json" nonce="<%= locals.cspNonce || '' %>">
<%- schemaJson %>
</script>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css">
<script nonce="<%= locals.cspNonce || '' %>">document.documentElement.dataset.theme=localStorage.getItem('sfeDarkTheme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');</script>
</head>
<body>
<div class="page">
  <%- include('partials/header', {
    headerNavItems: [
      { href: '/methodology', label: 'Methodology', className: 'header-nav-link' },
      { href: '/', label: 'Calculator', className: 'header-nav-pill' }
    ]
  }) %>

  <main class="main">
    <div class="container seo-container">
      <div class="page-heading">
        <h1><%= page.title %></h1>
        <p><%= page.description %></p>
      </div>

      <section class="card seo-content">
        <% if (page.kind === 'country') { %>
          <h2>How repayments work in <%= page.country %></h2>
          <p>
            If you live in <%= page.country %>, the Student Loans Company assesses your income against an overseas earnings threshold for your repayment plan. Your salary is converted to GBP using the official overseas threshold table, then the repayment rate is applied only to income above the threshold.
          </p>
          <p>
            Use the calculator to enter your gross annual salary in <%= page.currency %>, choose Plan 1, Plan 2, Plan 4, Plan 5, and optionally include a Postgraduate Loan.
          </p>
          <% if (page.localNotes && page.localNotes.length) { %>
            <h2>Local income notes for <%= page.country %></h2>
            <ul>
              <% page.localNotes.forEach(function(note) { %>
                <li><%= note %></li>
              <% }); %>
            </ul>
          <% } %>

          <% if (thresholds.length) { %>
            <div class="seo-fact-grid" aria-label="<%= page.country %> repayment facts">
              <div class="seo-fact">
                <span class="seo-fact-label">Local salary currency</span>
                <strong><%= countrySummary.currencyCode %></strong>
              </div>
              <div class="seo-fact">
                <span class="seo-fact-label">Published plans available</span>
                <strong><%= countrySummary.planCount %></strong>
              </div>
              <% if (countrySummary.thresholdRange) { %>
                <div class="seo-fact">
                  <span class="seo-fact-label">GBP threshold range</span>
                  <strong><%= countrySummary.thresholdRange %></strong>
                </div>
              <% } %>
            </div>

            <h2><%= taxYear %> threshold examples</h2>
            <p>
              These figures show the published GBP threshold for <%= page.country %>, the exchange rate in the threshold table, and the approximate equivalent salary in <%= countrySummary.currencyCode %>. The local equivalents are rounded for readability.
            </p>
            <div class="seo-table-wrap">
              <table class="seo-table">
                <thead>
                  <tr>
                    <th>Plan</th>
                    <th>Overseas threshold</th>
                    <th>Approx. local threshold</th>
                    <th>Exchange rate</th>
                  </tr>
                </thead>
                <tbody>
                  <% thresholds.forEach(function(row) { %>
                    <tr>
                      <td><%= row.plan %></td>
                      <td><%= row.threshold %></td>
                      <td><%= row.thresholdLocal || 'n/a' %></td>
                      <td><%= row.exchangeRate %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (countrySummary.primaryExample) { %>
              <h2>Worked repayment example</h2>
              <p>
                For <%= countrySummary.primaryExample.plan %>, a gross salary of about <%= countrySummary.primaryExample.exampleSalaryLocal %> in <%= page.country %> converts to roughly <%= countrySummary.primaryExample.exampleSalaryGbp %>. That is £10,000 above the listed threshold, so the estimated repayment is about <%= countrySummary.primaryExample.exampleMonthly %> per month at <%= countrySummary.primaryExample.ratePercent %>.
              </p>
            <% } %>

            <% if (salaryExamples.length) { %>
              <h2>Sample <%= page.currency %> salary estimates</h2>
              <p>
                The examples below use <%= salaryExamples[0].plan %> at <%= salaryExamples[0].ratePercent %> so you can see how different gross salaries change the monthly estimate. Choose your actual plan in the calculator for a personalised result.
              </p>
              <div class="seo-table-wrap">
                <table class="seo-table">
                  <thead>
                    <tr>
                      <th>Gross local salary</th>
                      <th>GBP equivalent</th>
                      <th>Estimated monthly repayment</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% salaryExamples.forEach(function(row) { %>
                      <tr>
                        <td><%= row.salaryLocal %></td>
                        <td><%= row.salaryGbp %></td>
                        <td><%= row.monthlyRepayment %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <h2>What to check before using the estimate</h2>
            <ul>
              <% estimateChecks.forEach(function(item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>

            <h2>Common mistakes to avoid</h2>
            <ul>
              <% commonMistakes.forEach(function(item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
            <p class="seo-source-note">
              Source note: thresholds and exchange rates are based on public GOV.UK and Student Loans Company overseas threshold publications for <%= taxYear %>. This page was last reviewed on <%= lastReviewed %>.
            </p>
          <% } else { %>
            <h2>Threshold data currently unavailable</h2>
            <p>
              The calculator can still be used from the main page, but the country-specific threshold table for <%= page.country %> could not be loaded for this guide. If you have a Student Loans Company letter, compare its threshold and exchange rate with the calculator result before relying on the estimate.
            </p>
          <% } %>
        <% } else { %>
          <h2>What counts for <%= page.plan %> overseas repayments?</h2>
          <p><%= page.intro %></p>
          <p>
            The calculator supports the current published overseas threshold tables for <%= taxYear %>. Enter your country of residence and annual gross salary in local currency to estimate your monthly repayment.
          </p>
          <% if (page.who) { %>
            <h2>Who usually uses <%= page.plan %>?</h2>
            <p><%= page.who %></p>
          <% } %>
          <h2>Repayment rate</h2>
          <p>
            <%= page.plan === 'Postgraduate Loan' ? 'Postgraduate Loans are repaid at 6% of income above the overseas threshold.' : page.plan + ' repayments are usually 9% of income above the overseas threshold.' %>
          </p>
          <% if (page.overseasNotes && page.overseasNotes.length) { %>
            <h2>Overseas calculation notes</h2>
            <ul>
              <% page.overseasNotes.forEach(function(note) { %>
                <li><%= note %></li>
              <% }); %>
            </ul>
          <% } %>
          <% if (page.checklist && page.checklist.length) { %>
            <h2>Before calculating</h2>
            <ul>
              <% page.checklist.forEach(function(item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          <% } %>
          <p class="seo-source-note">
            Source note: repayment rates and overseas threshold handling are based on public GOV.UK and Student Loans Company guidance for supported tax years. This page was last reviewed on <%= lastReviewed %>.
          </p>
        <% } %>

        <% if (guideFaqs && guideFaqs.length) { %>
          <h2>Frequently asked questions</h2>
          <dl class="seo-faq-list">
            <% guideFaqs.forEach(function(faq) { %>
              <div class="seo-faq-item">
                <dt><%= faq.question %></dt>
                <dd><%= faq.answer %></dd>
              </div>
            <% }); %>
          </dl>
        <% } %>

        <h2>Important caveats</h2>
        <p>
          This tool is an estimate. Official repayment notices can use different exchange rates, updated thresholds, or account-specific details. Always verify final amounts with the Student Loans Company.
        </p>

        <div class="seo-actions">
          <a href="/" class="btn-calculate">Open calculator</a>
          <a href="/methodology" class="seo-secondary-link">How the formula works</a>
        </div>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>
</div>
<script src="/theme.js" defer></script>
</body>
</html>
