    "chart.js": "4.5.1",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.6",
    "currency-symbol-map": "^5.1.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^5.0.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
